{
  "format_on_save": "on",
  "prettier": {
    "allowed": true
  },
  "ui_font_family": ".SystemUIFont",
  "ui_font_weight": 300.0,
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 300.0,
  "buffer_font_family": "Maple Mono NF",
  "inlay_hints": {
    "show_type_hints": false
  },
  "show_edit_predictions": true,
  "agent_servers": {},
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "button": false,
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "edit_predictions": {
    "copilot": {
      "enable_next_edit_suggestions": true
    },
    "mode": "eager",
    "provider": "copilot"
  },
  "show_signature_help_after_edits": false,
  "scrollbar": {
    "selected_text": false,
    "selected_symbol": false,
    "axes": {
      "horizontal": true
    },
    "git_diff": true,
    "cursors": false
  },
  "soft_wrap": "editor_width",
  "show_wrap_guides": true,
  "calls": {
    "mute_on_join": true
  },
  "auto_signature_help": false,
  "which_key": {
    "enabled": true
  },
  "unnecessary_code_fade": 0.5,
  "auto_update": false,
  "on_last_window_closed": "quit_app",
  "when_closing_with_no_tabs": "keep_window_open",
  "context_servers": {
    "tanstack": {
      "enabled": true,
      "remote": false,
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://gitmcp.io/TanStack/router"]
    },
    "mcp-server-github": {
      "enabled": true,
      "remote": false,
      "settings": {
        "github_personal_access_token": "GITHUB_PERSONAL_ACCESS_TOKEN"
      }
    },
    "daisyui-github": {
      "enabled": true,
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://gitmcp.io/saadeghi/daisyui"]
    }
  },
  "agent": {
    "dock": "left",
    "thinking_display": "always_collapsed",
    "sandbox_permissions": {
      "allow_unsandboxed": true,
      "network_hosts": ["github.com"],
      "allow_all_hosts": false
    },
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "gpt-5.4-mini",
      "enable_thinking": false
    },
    "tool_permissions": {
      "default": "allow"
    },
    "favorite_models": [
      {
        "provider": "opencode",
        "model": "go/deepseek-v4-flash",
        "enable_thinking": true,
        "effort": "max"
      }
    ],
    "default_profile": "write",
    "default_model": {
      "provider": "opencode",
      "model": "go/deepseek-v4-flash",
      "enable_thinking": true,
      "effort": "max"
    },
    "model_parameters": []
  },
  "icon_theme": "Colored Zed Icons Theme Dark",
  "vim_mode": true,
  "ui_font_size": 16.0,
  "buffer_font_size": 16.0,
  "theme": "Catppuccin Mocha",
  "tab_size": 2,
  "languages": {
    "Python": {
      "tab_size": 4
    },
    "Rust": {
      "tab_size": 4
    },
    "Go": {
      "tab_size": 4
    },
    "CSS": {
      "language_servers": ["tailwindcss-language-server"]
    }
  },
  "terminal": {
    "font_family": "Maple Mono NF",
    "font_size": 15.0,
    "shell": {
      "program": "/run/current-system/sw/bin/fish"
    }
  }
}
